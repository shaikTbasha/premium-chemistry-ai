datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  name                 String?
  password             String?
  clerkId              String?                @unique
  resetToken           String?                @unique
  resetExpiry          DateTime?
  stripeCustomerId     String?                @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  stripeStatus         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  analyses  PdfAnalysis[]
  molecules Molecule[]
}

model Molecule {
  id        String   @id @default(cuid())
  name      String
  formula   String
  smiles    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PdfAnalysis {
  id        String   @id @default(cuid())
  fileName  String
  fileSize  Int?
  status    String   @default("PENDING")
  result    String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChemistryTopic {
  id          String                 @id @default(cuid())
  name        String
  category    String
  description String?
  questions   PreviousYearQuestion[]
  createdAt   DateTime               @default(now())

  @@index([category])
}

model PreviousYearQuestion {
  id            String         @id @default(cuid())
  topicId       String
  topic         ChemistryTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  examName      String
  year          Int
  question      String         @db.Text
  options       String[]
  correctAnswer String
  explanation   String         @db.Text
  difficulty    String         @default("Medium")
  createdAt     DateTime       @default(now())

  @@index([topicId])
  @@index([examName])
  @@index([year])
}